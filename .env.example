# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173

# --- Database / cache ---
DATABASE_URL=postgresql+psycopg://satquery:satquery@localhost:5432/satquery
REDIS_URL=redis://localhost:6379/0

# --- Object storage (imagery, artifacts) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=satquery

# --- LLM / agent orchestration ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# --- Imagery providers ---
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
PLANETARY_COMPUTER_KEY=
MAPBOX_TOKEN=

# --- Models ---
MODEL_REGISTRY_PATH=models/model_registry.yaml
MODEL_CHECKPOINT_DIR=models/checkpoints
MODEL_DEVICE=cuda
