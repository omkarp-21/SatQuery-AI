# Copy to .env and fill in. Never commit .env.
# Only variables actually read by the code are listed here.
# (docker-compose.yml carries its own PostGIS/Redis/MinIO defaults;
# the app does not connect to those services yet.)

# --- Data ---
# Base directory images are resolved under (path-traversal guard root).
SATQUERY_DATA_DIR=./data

# --- Model checkpoints (each overrides its built-in default path) ---
# Single-image scene ranking (RemoteCLIP ViT-B-32 .pt file).
SATQUERY_REMOTECLIP_CKPT=models/cache/remoteclip/RemoteCLIP-ViT-B-32.pt
# Bi-temporal change detection (directory holding the ChangeFormer checkpoint).
SATQUERY_CHANGEFORMER_CKPT_DIR=models/cache/changeformer
# Optical+SAR representations. Pattern: SATQUERY_<MODEL>_CKPT (e.g. CROMA, DOFA).
SATQUERY_CROMA_CKPT=models/cache/croma/CROMA_base.pt
SATQUERY_DOFA_CKPT=models/cache/dofa/DOFA_ViT_base_e100.pth

# --- Planner selection ---
# rule (default, deterministic) | llm (opt-in local planner) | hybrid (opt-in LLM intent + deterministic synthesis).
SATQUERY_PLANNER=rule
# 1 = keep one long-lived local-model process for repeat planner calls (evaluation/demo use).
SATQUERY_PLANNER_PERSISTENT=
# Provider id for the LLM planner path (default: local_qwen).
SATQUERY_PLANNER_PROVIDER=local_qwen
# 1 = verbose planner prompt (default is the compact prompt for small CPU models).
SATQUERY_PLANNER_VERBOSE=
# Optional OpenAI-compatible HTTP endpoint for the planner (when set, used instead of the local model).
SATQUERY_PLANNER_API_BASE=
SATQUERY_PLANNER_API_KEY=
SATQUERY_PLANNER_API_MODEL=gpt-4o-mini
