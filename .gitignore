# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
apps/frontend/dist/
apps/frontend/build/
.vite/
*.local

# --- Models & data (large binaries) ---
models/checkpoints/**
!models/checkpoints/.gitkeep
models/cache/**
!models/cache/.gitkeep
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/uploads/**
!data/uploads/.gitkeep
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# --- Vendored research repos (external/research/) ---
# Cloned for reference only. Never committed, never modified. Commit hashes are
# recorded in external/research/README.md and docs/research/model_inventory.md.
external/research/*/
!external/research/papers/
!external/research/benchmarks/

# --- Evaluation outputs ---
evaluation/reports/**
!evaluation/reports/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Docker / logs ---
*.log
logs/
.cache/

# --- local model validation venvs ---
.venvs/

# G14 agent eval — keep only latest.json in git
evaluation/agent/reports/*.json
!evaluation/agent/reports/latest.json

# --- Internal / competition materials — kept locally, never published ---
chatgpt.context.md
AGENT_PROMPT.md
SatQuery_SIH_Final_Deck.pptx
docs/sih/
